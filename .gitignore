# Project local data and student workspaces
# Use `dir/*` (not `dir/`) so re-include rules below can take effect
projects/01_yla_learning_companion/workspace/*
projects/02_research_report_helper/data/*
projects/03_sales_inventory_tracker/data/*

# Keep .gitkeep so empty dirs are tracked
!projects/01_yla_learning_companion/workspace/.gitkeep
!projects/02_research_report_helper/data/.gitkeep
!projects/03_sales_inventory_tracker/data/.gitkeep

# Sample data for project 03 must be committed
!projects/03_sales_inventory_tracker/data/sample_*.csv

# Marp build artifacts (any deck.pdf/pptx/html under projects/04 or 05)
projects/04_yla_intro_lecture/slides/deck.pdf
projects/04_yla_intro_lecture/slides/deck.pptx
projects/04_yla_intro_lecture/slides/deck.html
