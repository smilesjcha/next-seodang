# ===========================================
# ScholarLens 환경변수
# ===========================================
# 이 파일을 .env.local로 복사하고 실제 값을 입력하세요.
# cp .env.example .env.local

# --- 데이터베이스 ---
DATABASE_URL="postgresql://user:password@localhost:5432/scholarlens?schema=public"

# --- 인증 (NextAuth.js) ---
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-here"

# --- AI / LLM ---
OPENAI_API_KEY="sk-your-openai-api-key-here"
# 사용할 모델 (기본: gpt-4)
OPENAI_MODEL="gpt-4"

# --- 학술 API (선택) ---
# Semantic Scholar API (무료, 키 없이도 사용 가능하나 rate limit 있음)
SEMANTIC_SCHOLAR_API_KEY=""
# CrossRef API (Polite Pool 이용 시 이메일 필요)
CROSSREF_EMAIL=""

# --- 파일 저장소 ---
# 로컬 저장소 경로 (기본: ./storage)
STORAGE_PATH="./storage"
# 최대 업로드 파일 크기 (MB)
MAX_UPLOAD_SIZE_MB="50"

# --- 앱 설정 ---
# 근거 추출 시 최소 신뢰도 (0.0 ~ 1.0)
MIN_EVIDENCE_CONFIDENCE="0.7"
